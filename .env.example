
APP_NAME="CPC Inventory Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MySQL Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpc_inventory
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Application Services
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis (Optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CPC HR SQL Server Database
CPC_SQLSRV_URL=
CPC_SQLSRV_HOST=
CPC_SQLSRV_PORT=1433
CPC_SQLSRV_DATABASE=
CPC_SQLSRV_USERNAME=
CPC_SQLSRV_PASSWORD=

# CPC Help Desk and Asset Management SQL Server
CPC_ASSET_SQLSRV_URL=
CPC_ASSET_SQLSRV_HOST=
CPC_ASSET_SQLSRV_PORT=1433
CPC_ASSET_SQLSRV_DATABASE=
CPC_ASSET_SQLSRV_USERNAME=
CPC_ASSET_SQLSRV_PASSWORD=

# SQL Server Security
CPC_SQLSRV_ENCRYPT=yes
CPC_SQLSRV_TRUST_SERVER_CERTIFICATE=false

# Vite
VITE_APP_NAME="${APP_NAME}"
